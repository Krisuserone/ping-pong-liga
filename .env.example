# Supabase project settings → API. The publishable/anon key is safe to expose in the browser;
# all data access is enforced by Row Level Security in the database.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: show "sign in with email and password" on the live site (normally hidden;
# always shown during local development). Players sign in with Google.
# VITE_ENABLE_PASSWORD_LOGIN=true
